{
  "name": "decompose.js",
  "description": "Decompose a object.",
  "version": "1.1.1",
  "main": "decompose.js",
  "module": "decompose.mjs",
  "types": "decompose.d.ts",
  "files": [
    "*.js",
    "*.mjs",
    "*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./decompose.d.ts",
      "import": "./decompose.mjs",
      "require": "./decompose.js"
    },
    "./Composition": {
      "types": "./Composition.d.ts",
      "import": "./Composition.mjs",
      "require": "./Composition.js"
    },
    "./expect": {
      "types": "./expect.d.ts",
      "import": "./expect.mjs",
      "require": "./expect.js"
    },
    "./logger": {
      "types": "./logger.d.ts",
      "import": "./logger.mjs",
      "require": "./logger.js"
    },
    "./decompose-old": {
      "types": "./decompose-old.d.ts",
      "import": "./decompose-old.mjs",
      "require": "./decompose-old.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "doc": "typedoc",
    "build": "bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "for f in decompose expect logger Composition decompose-old; do bun build ./src/$f.ts --outdir . --format cjs --target node; done",
    "build:esm": "for f in decompose expect logger Composition decompose-old; do bun build ./src/$f.ts --outdir . --format esm --target node --entry-naming $f.mjs; done",
    "build:types": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun run typecheck && bun test",
    "coverage": "bun test --coverage"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [
    "object"
  ],
  "author": "Jonathan Delgado <hi@jon.soy>",
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "setimmutable": "^1.0.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/decompose.js.git"
  },
  "bugs": {
    "url": "https://github.com/JonDotsoy/decompose.js/issues"
  },
  "homepage": "https://github.com/JonDotsoy/decompose.js#readme"
}
