{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".",
    "types": ["node", "bun"]
  },
  "include": ["src"],
  "exclude": []
}
